# ForexMind AI backend - VPS environment (setup.sh copies this to .env).
# Fill every <...> from the OLD Render dashboard -> forexmind-ai-api ->
# Environment (viewable while suspended). Keep this file secret - it holds
# keys. It is git-ignored and never leaves the VPS.

# ---- data (your data lives here; miss these = empty app) -------------------
DATABASE=supabase
SUPABASE_URL=https://acaxgkatbengkfpxsmff.supabase.co
SUPABASE_SERVICE_KEY=<paste from Render: SUPABASE_SERVICE_KEY>

# ---- auth -------------------------------------------------------------------
FOREXMIND_JWT_SECRET=<paste from Render: FOREXMIND_JWT_SECRET>
FOREXMIND_OWNER_USER_ID=<paste from Render if present, else cletusmawa>

# ---- market data ------------------------------------------------------------
MARKET_DATA_PROVIDER=live
TWELVEDATA_API_KEY=<paste from Render: TWELVEDATA_API_KEY>

# ---- execution (MT5 bridge on this same VPS) --------------------------------
EXECUTION_MODE=mt5_bridge
# The REAL token lives on the bridge VPS (forexmind-bridge service env).
# Read it from the running process if unknown:
#   cat /proc/$(pgrep -f bridge.py | head -1)/environ | tr '\0' '\n' | grep BRIDGE
MT5_BRIDGE_TOKEN=<copy from the bridge's own env - NOT the trade magic number>
# MT5_BRIDGE_URL is fixed in docker-compose.yml (http://169.58.98.139:8700)

# ---- Telegram phone alerts --------------------------------------------------
TELEGRAM_BOT_TOKEN=<paste from Render: TELEGRAM_BOT_TOKEN>
TELEGRAM_BOT_USERNAME=<paste from Render: TELEGRAM_BOT_USERNAME>
TELEGRAM_WEBHOOK_SECRET=fxm-hook
TELEGRAM_DEFAULT_CHAT_ID=<paste from Render: TELEGRAM_DEFAULT_CHAT_ID>

# ---- AI brain ---------------------------------------------------------------
XKIRO_API_KEY=<paste from Render: XKIRO_API_KEY>

# ---- app --------------------------------------------------------------------
PUBLIC_APP_URL=https://forexmind-ai-v3.netlify.app
# add any other variables you see in Render's Environment tab that are not
# listed here (EXECUTION_*, MARKETS_EXTRA, ...) - copy them 1:1
