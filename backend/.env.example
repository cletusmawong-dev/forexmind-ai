# ForexMind AI - environment template (VPS-readiness)
# Copy to .env and fill in. NEVER commit real credentials.

# --- Database (Firestore) ---
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- AI provider (XKiro) ---
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL=mistral-large-2512

# --- Market data ---
# historical_demo | live
MARKET_DATA_PROVIDER=historical_demo
TWELVEDATA_API_KEY=
# Optional broker-grade candles (OANDA practice)
OANDA_API_TOKEN=
OANDA_ENV=practice
# Future tick-stream provider (VPS). Leave EMPTY until a real stream exists -
# the app honestly reports "no streaming" while these are unset.
MARKET_DATA_STREAM_URL=
MARKET_DATA_STREAM_API_KEY=
DATA_TIMEZONE=UTC

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEFAULT_CHAT_ID=

# --- MT5 execution (STAYS OFF until the user explicitly enables it) ---
EXECUTION_MODE=off
EXECUTION_KILL_SWITCH=true
MT5_BRIDGE_URL=
MT5_BRIDGE_TOKEN=
EXECUTION_MAX_TRADES_PER_DAY=6
EXECUTION_RISK_PCT_CAP=1.0
EXECUTION_TP_LEVEL=2

# --- Auth ---
FOREXMIND_JWT_SECRET=change-me-to-a-long-random-string

# --- Misc ---
REPLAY_ENABLED=0
